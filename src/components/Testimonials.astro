---
// Testimonials.astro - Community testimonials

const testimonials = [
  {
    quote: "Ik had niet meer gerend sinds de middelbare school. Toen kwam ik om 6 uur 's ochtends doodsbang opdagen bij Just Screw It. Bij kilometer 1 maakte iemand een verschrikkelijke grap, ik lachte, en opeens vergat ik om nerveus te zijn.",
    name: "Marcus",
    age: 34,
    tagline: 'Ex "ik-ben-geen-hardloper" (zijn we dat niet allemaal?)',
    image: "/images/marcus.png",
  },
  {
    quote: "Het moment dat ze zeiden 'alle tempo's welkom' wist ik dat dit anders was. Geen Strava-opschepperij. Gewoon mensen die oprecht blij zijn dat je kwam opdagen.",
    name: "Jen",
    age: 28,
    tagline: "Loopt nu 3x per week",
    image: "/images/jen.png",
  },
  {
    quote: "Mijn vrouw zegt dat ik een ander mens ben sinds ik bij deze groep zit. Minder gestrest, fitter, en ik heb eindelijk vrienden die niet van het werk zijn. Ze is wel jaloers op de zondagsbrunch.",
    name: "Tom",
    age: 41,
    tagline: "Van 0 naar halve marathon (en 10 kg lichter)",
    image: "/images/tom.png",
  },
];
---

<section id="community" class="section-padding">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl font-heading font-black uppercase text-white">
        Echte Verhalen. Echt Zweet. Geen Onzin.
      </h2>
      <p class="mt-4 text-lg text-muted max-w-xl mx-auto">
        Niet gesponsord. Niet betaald. Wel bezweet.
      </p>
    </div>

    <!-- Testimonials grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((t, i) => (
        <div
          class:list={[
            "glass-card p-8 flex flex-col animate-fade-in-up",
            i === 0 && "animate-delay-100",
            i === 1 && "animate-delay-200",
            i === 2 && "animate-delay-300",
          ]}
        >
          {/* Member photo */}
          <div class="flex justify-center mb-5">
            <img
              src={t.image}
              alt={`${t.name} - Just Screw It lid`}
              class="w-full h-48 object-cover object-top rounded-xl ring-2 ring-primary/30 shadow-lg"
              loading="lazy"
            />
          </div>

          {/* Opening quote mark */}
          <span class="text-6xl font-heading font-black text-primary leading-none opacity-50 select-none" aria-hidden="true">
            &ldquo;
          </span>

          {/* Quote */}
          <blockquote class="mt-2 mb-6 flex-1">
            <p class="text-white/90 italic leading-relaxed">
              {t.quote}
            </p>
          </blockquote>

          {/* Author */}
          <div class="pt-4 border-t border-white/10">
            <span class="font-bold text-white">{t.name}</span>
            <span class="text-muted">, {t.age}</span>
            <span class="text-muted mx-2">|</span>
            <span class="text-muted text-sm">{t.tagline}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
