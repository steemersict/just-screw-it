---
// Schedule.astro - Weekly training schedule

const sessions = [
  {
    day: "Maandag",
    time: "06:30",
    type: "Easy Run",
    subtitle: "Zo makkelijk dat je nog kunt klagen over je weekend",
    distance: "5-8km",
    level: "Alle niveaus",
    levelColor: "text-green-400 bg-green-400/10 border-green-400/30",
    location: "Vondelpark",
    highlight: false,
  },
  {
    day: "Dinsdag",
    time: "18:30",
    type: "Tempo Training",
    subtitle: "Hier mag je wel even hijgen",
    distance: "8-12km",
    level: "Gemiddeld+",
    levelColor: "text-orange-400 bg-orange-400/10 border-orange-400/30",
    location: "Amsterdamse Bos",
    highlight: false,
  },
  {
    day: "Woensdag",
    time: "07:00",
    type: "Trail Run",
    subtitle: "Modder is gratis camouflage",
    distance: "6-10km",
    level: "Alle niveaus",
    levelColor: "text-green-400 bg-green-400/10 border-green-400/30",
    location: "Gooi & Vechtstreek",
    highlight: false,
  },
  {
    day: "Donderdag",
    time: "19:00",
    type: "Intervals",
    subtitle: "Kort. Pijnlijk. Verslavend.",
    distance: "6-8km",
    level: "Gevorderd",
    levelColor: "text-red-400 bg-red-400/10 border-red-400/30",
    location: "Olympisch Stadion",
    highlight: false,
  },
  {
    day: "Zaterdag",
    time: "08:00",
    type: "Long Run",
    subtitle: "Waar vriendschappen (en blaren) ontstaan",
    distance: "15-25km",
    level: "Alle niveaus",
    levelColor: "text-green-400 bg-green-400/10 border-green-400/30",
    location: "Wisselende routes",
    highlight: false,
  },
  {
    day: "Zondag",
    time: "09:00",
    type: "Recovery Run",
    subtitle: "Eigenlijk gewoon een excuus voor brunch",
    distance: "5km + Brunch",
    level: "Alle niveaus",
    levelColor: "text-green-400 bg-green-400/10 border-green-400/30",
    location: "Westerpark",
    highlight: true,
  },
];
---

<section id="schema" class="section-padding">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl font-heading font-black uppercase">
        <span class="gradient-text">Trainingsschema</span>
      </h2>
      <p class="mt-4 text-lg text-muted max-w-xl mx-auto">
        Kies je dag. Kies je tempo. Kies je excuus om niet te gaan — en negeer het.
      </p>
    </div>

    <!-- Schedule grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sessions.map((session, i) => (
        <div
          class:list={[
            "glass-card p-6 animate-fade-in-up",
            session.highlight && "border-[#22C55E]/50 ring-1 ring-[#22C55E]/20",
            i === 0 && "animate-delay-100",
            i === 1 && "animate-delay-100",
            i === 2 && "animate-delay-200",
            i === 3 && "animate-delay-200",
            i === 4 && "animate-delay-300",
            i === 5 && "animate-delay-300",
          ]}
        >
          {/* Day header */}
          <div class="flex items-baseline justify-between mb-3">
            <h3 class="text-2xl font-heading font-black uppercase text-white">
              {session.day}
            </h3>
            <span class="text-lg font-heading font-bold text-primary-light">
              {session.time}
            </span>
          </div>

          {/* Type */}
          <p class="text-xl font-heading font-semibold uppercase text-white/90 mb-1">
            {session.type}
          </p>
          <p class="text-sm text-muted italic mb-4">
            {session.subtitle}
          </p>

          {/* Details */}
          <div class="space-y-2">
            {/* Distance */}
            <div class="flex items-center gap-2 text-muted">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>{session.distance}</span>
            </div>

            {/* Location */}
            <div class="flex items-center gap-2 text-muted">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{session.location}</span>
            </div>

            {/* Level badge */}
            <div class="pt-2">
              <span class={`inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full border ${session.levelColor}`}>
                {session.level}
              </span>
            </div>
          </div>

          {/* Brunch highlight */}
          {session.highlight && (
            <div class="mt-4 pt-3 border-t border-white/10 text-sm text-[#22C55E] font-semibold">
              Inclusief brunch na afloop (de echte reden dat iedereen komt)
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
