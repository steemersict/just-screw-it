---
// Sponsors.astro - Hoofdsponsor sectie
---

<section class="py-16 border-t border-b border-white/5">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <p class="text-sm font-heading uppercase tracking-[0.2em] text-muted mb-8">
      Trots gesponsord door
    </p>

    <a
      href="https://fekobv.nl"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block group cursor-pointer"
    >
      <div class="glass-card px-12 py-8 inline-flex flex-col items-center gap-4 transition-all duration-300 group-hover:ring-2 group-hover:ring-primary/40">
        <img
          src="/images/sponsor-fekobv.png"
          alt="FEKO BV - Hoofdsponsor van Just Screw It"
          class="h-12 md:h-16 w-auto opacity-80 group-hover:opacity-100 transition-opacity duration-300"
          loading="lazy"
        />
        <span class="text-xs text-muted uppercase tracking-wider">Hoofdsponsor</span>
      </div>
    </a>

    <p class="mt-6 text-sm text-muted/60 italic max-w-md mx-auto">
      Zij leveren de bouwmaterialen. Wij leveren de spierpijn.
    </p>
  </div>
</section>
